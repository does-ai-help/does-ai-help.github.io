{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI and Intellectual Work Evidence Map",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "url", "authors", "topics", "method", "publication_status", "summary", "limitations", "verified", "verification", "editorial_priority"],
    "properties": {
      "id": {"type":"string","pattern":"^[a-z0-9-]+$"},
      "title": {"type":"string","minLength":1},
      "url": {"type":"string","format":"uri"},
      "authors": {"type":"array","items":{"type":"string"}},
      "editors": {"type":"array","items":{"type":"string"}},
      "publisher": {"type":"string"},
      "date_basis": {"type":"string"},
      "study_family": {"type":"string"},
      "document_verification": {
        "type": "object",
        "required": ["method", "checked_on", "filename", "sha256", "pages", "scope", "redistributed"],
        "properties": {
          "method": {"enum": ["user-supplied-pdf-plus-local-chrome", "public-publisher-pdf"]},
          "checked_on": {"type": "string", "format": "date"},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "pages": {"type": "integer", "minimum": 1},
          "scope": {"type": "string", "minLength": 1},
          "redistributed": {"const": false}
        }
      },
      "year": {"type":["integer","null"],"minimum":1900,"maximum":2100},
      "date": {"type":["string","null"]},
      "topics": {"type":"array","items":{"type":"string"}},
      "method": {"type":"string"},
      "publication_status": {"type":"string"},
      "summary": {"type":"string"},
      "limitations": {"type":"string"},
      "verified": {"type":"boolean"},
      "editorial_priority": {"enum":["core","supporting","pending"]},
      "verification": {
        "type":"object",
        "required":["level","checked_on"],
        "properties": {
          "level":{"enum":["content-checked","identity-checked","candidate"]},
          "checked_on":{"type":["string","null"]},
          "basis":{"type":"string"},
          "source_url":{"type":"string","format":"uri"}
        }
      },
      "version_note":{"type":"string"},
      "doi":{"type":"string"},
      "arxiv_id":{"type":"string","pattern":"^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"},
      "title_aliases":{"type":"array","items":{"type":"string","minLength":1}},
      "related_to":{"type":"array","items":{"type":"string"}},
      "dataset_family":{"type":"string"},
      "browser_verification": {
        "type": "object",
        "required": ["id", "method", "release_month", "checked_at", "source_url", "source_fingerprint", "reviewer", "outcome", "scope", "notes", "observed"],
        "properties": {
          "method": {"const": "local-chrome-native"},
          "release_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
          "checked_at": {"type": "string", "format": "date-time"},
          "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "outcome": {"enum": ["identity-confirmed", "access-blocked", "not-found", "mismatch"]},
          "observed": {"type": "object"},
          "scope": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
